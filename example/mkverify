#!/usr/bin/env python3
"""mkverify: build the verify task manifest from finished agent tasks.

  example/mkverify <run> <agent-task>... > tasks/<run>/<run>-coord-verify.yaml

Takes the last ```diff block from each task's output (read in full with
`ax get task`; `bin/axs result` truncates long output), and writes a command
task that applies every diff to a fresh copy of ex-textkit-ws, adds the hidden
acceptance tests, and runs the whole suite.
"""
import json
import os
import re
import subprocess
import sys

import yaml

HERE = os.path.dirname(os.path.abspath(__file__))


def task_diff(name):
    p = subprocess.run(["ax", "get", "task", name], capture_output=True, text=True)
    if p.returncode != 0:
        sys.exit(f"ax get task {name}: {p.stderr.strip()}")
    st = yaml.safe_load(p.stdout).get("status") or {}
    out = (st.get("outcome") or {}).get("output") or ""
    diffs = re.findall(r"```diff\n(.*?)```", out, re.S)
    if not diffs:
        sys.exit(f"{name}: no ```diff block in its output")
    # Drop per-file sections git apply cannot use: binaries and bytecode caches.
    files = re.split(r"(?m)^(?=diff --git )", diffs[-1])
    return "".join(f for f in files
                   if "__pycache__/" not in f.partition("\n")[0] and "\nBinary files " not in f)


def indent(text, n):
    return "".join(" " * n + line for line in text.splitlines(True))


def main():
    if len(sys.argv) < 3:
        sys.exit(__doc__)
    run, tasks = sys.argv[1], sys.argv[2:]
    patch = "".join(task_diff(t) for t in tasks)
    with open(os.path.join(HERE, "acceptance_test.py")) as f:
        acceptance = f.read()
    print(f"""# Verify run {run}: apply the diffs from {", ".join(tasks)}
# to a fresh copy of the workspace, add the hidden acceptance tests, and run
# every test. Done when this task SUCCEEDS. Generated by example/mkverify.
apiVersion: ax.io/v1alpha1
kind: Task
metadata:
  name: {run}-coord-verify
  atespace: default
  labels:
    swarm-run: {run}
    swarm-worker: coord
spec:
  workspace:
    name: ex-textkit-ws
  commands:
    - sh
    - -c
    - |
      set -e
      cd textkit
      git apply <<'PATCH'
{indent(patch, 6)}      PATCH
      cat > tests/test_acceptance.py <<'ACCEPTANCE'
{indent(acceptance, 6)}      ACCEPTANCE
      git status --short
      python3 -m unittest -v 2>&1
  debug: true""")


if __name__ == "__main__":
    main()
